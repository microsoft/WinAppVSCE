<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="SmokeFixture.SecondWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SmokeFixture"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SmokeFixture — Second Window"
    mc:Ignorable="d">

    <Grid Padding="24">
        <TextBlock
            x:Name="SecondWindowLabel"
            AutomationProperties.AutomationId="SecondWindowLabel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource SubtitleTextBlockStyle}"
            Text="Second window (separate XamlRoot)" />
    </Grid>
</Window>
