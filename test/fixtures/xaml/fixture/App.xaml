<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="SmokeFixture.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SmokeFixture">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="MergedResources.xaml" />
                <!-- App-level merged dictionary holding the shared accent brush used by
                     Title, AttachedProbe background, and the Repeater item template (resource-cascade test). -->
                <ResourceDictionary>
                    <SolidColorBrush x:Key="SmokeAccentBrush" Color="#FF3B82F6" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
