<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PrecedenceAccentBrush" Color="Blue" />
    <Style x:Key="WinningPrecedenceStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PrecedenceAccentBrush}" />
    </Style>
</ResourceDictionary>
