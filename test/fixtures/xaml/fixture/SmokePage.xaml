<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SmokeFixture.SmokePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SmokeFixture"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls.SettingsControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <!-- 1) ScrollViewer named Scroller wraps all page content. -->
    <ScrollViewer x:Name="Scroller" AutomationProperties.AutomationId="Scroller">
        <Grid Padding="24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 2) Title TextBlock using the shared SmokeAccentBrush. -->
            <TextBlock
                x:Name="Title"
                Grid.Row="0"
                AutomationProperties.AutomationId="Title"
                Foreground="{StaticResource SmokeAccentBrush}"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Smoke Fixture" />

            <!-- 3) BoundText via compiled binding (exercises x:Bind + generated .g.cs field). -->
            <TextBlock
                x:Name="BoundText"
                Grid.Row="1"
                AutomationProperties.AutomationId="BoundText"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind GreetingText, Mode=OneWay}" />

            <!-- 4) AttachedProbe Border with an attached property (Grid.Row="2") set. -->
            <Border
                x:Name="AttachedProbe"
                Grid.Row="2"
                Height="48"
                AutomationProperties.AutomationId="AttachedProbe"
                Background="{StaticResource SmokeAccentBrush}"
                CornerRadius="{StaticResource ControlCornerRadius}" />

            <!-- 5) ScratchInput TextBox for focus + unsaved-text tests. -->
            <TextBox
                x:Name="ScratchInput"
                Grid.Row="3"
                AutomationProperties.AutomationId="ScratchInput"
                Header="Scratch input"
                PlaceholderText="Type unsaved text here" />

            <!-- 6) GoButton with wired Click handler navigating the Frame to Page2. -->
            <Button
                x:Name="GoButton"
                Grid.Row="4"
                AutomationProperties.AutomationId="GoButton"
                Click="OnGo_Click"
                Content="Go to Page 2" />

            <!-- 7) ItemsRepeater bound via x:Bind; item template TextBlock reuses SmokeAccentBrush. -->
            <ItemsRepeater
                x:Name="Repeater"
                Grid.Row="5"
                AutomationProperties.AutomationId="Repeater"
                ItemsSource="{x:Bind Items}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock
                            Foreground="{StaticResource SmokeAccentBrush}"
                            Text="{x:Bind}" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </Grid>
    </ScrollViewer>
</Page>
