{
  "WinUI Grid with rows": {
    "prefix": "xgrid",
    "description": "Create a Grid with row definitions",
    "body": [
      "<Grid>",
      "\t<Grid.RowDefinitions>",
      "\t\t<RowDefinition Height=\"${1:Auto}\" />",
      "\t\t<RowDefinition Height=\"${2:*}\" />",
      "\t</Grid.RowDefinitions>",
      "\t$0",
      "</Grid>"
    ]
  },
  "WinUI x:Bind expression": {
    "prefix": "xbind",
    "description": "Create a compiled x:Bind expression",
    "body": "{x:Bind ${1:Property}, Mode=${2|OneTime,OneWay,TwoWay|}}$0"
  },
  "WinUI static resource reference": {
    "prefix": "xresource",
    "description": "Create a StaticResource reference",
    "body": "{StaticResource ${1:ResourceKey}}$0"
  },
  "WinUI Style": {
    "prefix": "xstyle",
    "description": "Create a keyed WinUI Style",
    "body": [
      "<Style x:Key=\"${1:StyleKey}\" TargetType=\"${2:Button}\">",
      "\t<Setter Property=\"${3:Property}\" Value=\"${4:Value}\" />",
      "\t$0",
      "</Style>"
    ]
  },
  "WinUI DataTemplate": {
    "prefix": "xdatatemplate",
    "description": "Create a typed DataTemplate",
    "body": [
      "<DataTemplate x:DataType=\"${1:local:ViewModel}\">",
      "\t$0",
      "</DataTemplate>"
    ]
  }
}
