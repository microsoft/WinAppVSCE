<?xml version="1.0" encoding="utf-8"?>
<!--
    S4 resource-scope proof dictionary.

    Compiled into TestUserApp.dll as a loose .xbf under TestUserApp\Themes\Styles.xbf and
    merged by the Surface host into Application.Current.Resources so that a runtime-parsed
    real page can resolve {StaticResource ...} and implicit styles.

    Contents:
      * AccentBrush      - a clearly visible SolidColorBrush (used as a Button Foreground).
      * HeaderTextStyle  - a KEYED TextBlock style (large + SemiBold), proves keyed lookup.
      * (implicit)Button - an IMPLICIT Button style (no x:Key), proves default/implicit styles
                           resolve for parsed controls. BasedOn the framework default keeps the
                           button ControlTemplate intact; the teal Background is the obvious
                           non-default proof.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <ResourceDictionary.MergedDictionaries>
        <!-- Self-merge the framework control resources so the BasedOn StaticResource below
             resolves within THIS dictionary no matter how the surface loads it (a dictionary
             assigned via Source loads in isolation and can't see sibling app dictionaries). -->
        <muxc:XamlControlsResources />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="AccentBrush" Color="#C2185B" />

    <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="#00897B" />
    </Style>
</ResourceDictionary>
