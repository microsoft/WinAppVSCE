<UserControl
    x:Class="TestUserApp.AppSingletonDemoControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        P2 App-init-recovery demo (coverage hardening). The code-behind constructor dereferences the static
        DesignTimeApp.AppService singleton (null in a headless host) BEFORE InitializeComponent — exactly the
        shape of the gallery ctors (idx3/idx23) that NRE on App.ModelDownloadQueue. When the host's App-init
        recovery seeds that singleton and retries the ctor, the control activates and the two TextBlocks
        (paths 0.0.0 / 0.0.1) surface values read from the seeded instance, proving the construction gate is
        crossed via a real seeded singleton (not a stub).
    -->
    <StackPanel Padding="24" Spacing="8">
        <TextBlock x:Name="StatusText" Text="Loading…" />
        <TextBlock x:Name="CountText" Text="Loading…" />
    </StackPanel>
</UserControl>
