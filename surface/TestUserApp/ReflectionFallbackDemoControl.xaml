<UserControl
    x:Class="TestUserApp.ReflectionFallbackDemoControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TestUserApp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        M3 opportunistic-reflection-fallback demo (§51). This control is ZERO-CONFIG: its code-behind does
        NOT seed any data (no design-mode branch, unlike the M2 demo). Models starts empty, so without the
        fallback the count TextBlock reads "0 items". With the opt-in fallback (SURFACE_DTD_REFLECT=1) the
        host reflects the empty x:Bind-backed Models collection, fabricates a bounded sample dataset, and
        re-runs Bindings.Update() → the count re-reads "3 items" and the list shows sample rows. The smoke
        suite reads back path 0.0.0 (count) to assert the fallback both engaged (opt-in) and stayed off by
        default (gate respected).
    -->
    <StackPanel Padding="24" Spacing="8">
        <TextBlock Text="{x:Bind ItemCountText}" />
        <ItemsControl ItemsSource="{x:Bind Models}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:DemoItem">
                    <TextBlock Text="{x:Bind Name}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
