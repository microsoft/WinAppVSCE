<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TestFixtureApp.Controls">

    <Style TargetType="controls:TagChip">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:TagChip">
                    <Border CornerRadius="10" Background="#00838F" Padding="10,2">
                        <TextBlock Text="{TemplateBinding Text}" Foreground="White" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:Section">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:Section">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{TemplateBinding Header}" FontWeight="SemiBold" />
                        <ContentPresenter Content="{TemplateBinding Body}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
