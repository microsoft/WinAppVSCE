<?xml version="1.0" encoding="utf-8"?>
<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">
    <StackPanel Padding="16" Spacing="12">
        <tk:SettingsCard Header="Notifications" Description="Toolkit settings card">
            <ToggleSwitch IsOn="True" />
        </tk:SettingsCard>
        <tk:Segmented SelectedIndex="0">
            <tk:SegmentedItem Content="Day" />
            <tk:SegmentedItem Content="Week" />
        </tk:Segmented>
    </StackPanel>
</Page>
