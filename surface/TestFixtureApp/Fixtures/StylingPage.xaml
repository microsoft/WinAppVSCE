<?xml version="1.0" encoding="utf-8"?>
<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <SolidColorBrush x:Key="PageBrush" Color="#7B1FA2" />
    </Page.Resources>
    <StackPanel Padding="16" Spacing="8">
        <!-- 0.0.0 page-scope brush -->
        <TextBlock Text="Page resource" Foreground="{StaticResource PageBrush}" />
        <!-- 0.0.1 keyed style from the project's Themes/Styles.xaml -->
        <TextBlock Text="Project style" Style="{StaticResource FixtureHeaderStyle}" />
        <!-- 0.0.2 app-scope brush from App.xaml -->
        <TextBlock Text="App resource" Foreground="{StaticResource AppAccentBrush}" />
        <!-- 0.0.3 implicit Button style from App.xaml -->
        <Button Content="Implicit style" />
        <!-- 0.0.4 project theme brush (Light/Dark) -->
        <Border Height="20" Background="{ThemeResource FixtureSurfaceBrush}" />
        <!-- 0.0.5 app theme brush (Light/Dark) -->
        <Border Height="20" Background="{ThemeResource AppThemeBrush}" />
        <!-- 0.0.6 framework theme brush -->
        <Border Height="20" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
        <!-- 0.0.7 a key only the running app adds: the preview shows the key name -->
        <TextBlock Text="{StaticResource KeyAddedAtRuntime}" />
    </StackPanel>
</Page>
