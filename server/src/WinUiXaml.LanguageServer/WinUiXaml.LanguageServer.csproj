<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WinUiXaml.LanguageServer</AssemblyName>
    <RootNamespace>WinUiXaml.LanguageServer</RootNamespace>
    <!-- Set here, not on the command line: command-line properties propagate to project references, and
         WinUiXaml.Xaml targets netstandard2.0, which fails with NETSDK1207. PublishAot also implies
         JsonSerializerIsReflectionEnabledByDefault=false, hence the source-generated JsonSerializerContext. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Report every trim/AOT warning individually instead of one rolled-up warning per assembly. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WinUiXaml.LanguageServer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinUiXaml.Xaml\WinUiXaml.Xaml.csproj" />
    <ProjectReference Include="..\WinUiXaml.Workspace\WinUiXaml.Workspace.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Source generators are analyzer assemblies loaded with Assembly.LoadFrom, which Native AOT cannot
         do, so the host stays a separate framework-dependent helper. Built here to keep it in lockstep;
         ReferenceOutputAssembly is off because the server launches it as a child process, never links it. -->
    <ProjectReference Include="..\WinUiXaml.GeneratorHost\WinUiXaml.GeneratorHost.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      Private="false" />
  </ItemGroup>

  <!-- Deploy the helper beside the server's *build* output, where HostAssemblyPath probes. Without it,
       running from bin (what the XAML smoke suite does) silently degrades every project to "no generated
       members", the blind spot that let a helper deadlock ship past a green suite. $(OutDir), not $(PublishDir). -->
  <Target Name="CopyGeneratorHostBesideServer" AfterTargets="Build">
    <ItemGroup>
      <_HostPayload Include="$(MSBuildThisFileDirectory)..\WinUiXaml.GeneratorHost\bin\$(Configuration)\net10.0\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_HostPayload)"
          DestinationFiles="@(_HostPayload->'$(OutDir)generator-host\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(_HostPayload)' != ''" />
  </Target>

</Project>
