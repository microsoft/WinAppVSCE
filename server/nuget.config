<?xml version="1.0" encoding="utf-8"?>
<!--
  Pins the package feed used to restore the WinUI XAML language server (server/**) so `dotnet
  restore`/`publish` is deterministic for both local development and the release pool, regardless of
  any machine- or user-level NuGet configuration. <clear /> drops inherited sources first.

  Maintainers: if the release pool blocks public NuGet egress, replace the nuget.org entry below with
  the approved internal mirror (see docs/RELEASE.md). Keep a single, explicit source.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
