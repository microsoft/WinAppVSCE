<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Compile-only MSBuild advisories flow in transitively from WinUiXaml.Workspace; the runtime
         copies come from the SDK (Build.Locator), so they don't apply here. -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- Author in-memory C# compilations for hermetic type-system tests (no WinUI/MSBuild load). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WinUiXaml.Workspace\WinUiXaml.Workspace.csproj" />
    <!-- Built for ordering only; the assembly is loaded out-of-process, never referenced. -->
    <ProjectReference Include="..\..\src\WinUiXaml.GeneratorHost\WinUiXaml.GeneratorHost.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <!--
    Mirror the shipped layout (dist/server/<rid>/../generator-host/) so the integration tests
    resolve the helper exactly the way the product does, instead of through a test-only override.
  -->
  <Target Name="CopyGeneratorHostForTests" AfterTargets="Build">
    <ItemGroup>
      <_GeneratorHostFiles Include="$(MSBuildThisFileDirectory)..\..\src\WinUiXaml.GeneratorHost\bin\$(Configuration)\net10.0\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_GeneratorHostFiles)"
          DestinationFiles="@(_GeneratorHostFiles->'$(OutDir)generator-host\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
