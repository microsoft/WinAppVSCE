<UserControl x:Class="WinUIXamlPreview.UI.PreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="450" d:DesignWidth="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- U2: non-blocking banners (XAML error over the last good render, static-preview note, full-fidelity
             upgrade) are VS-style info bars docked at the TOP of the pane in their own row. Being a separate
             layout row (not an overlay) is what makes them visible in native mode: the reparented WinUI HWND
             lives in row 1 and shrinks below them, whereas a WPF overlay would be painted over (airspace).
             Populated in code (PreviewInfoBar). -->
        <StackPanel x:Name="BannerHost" Grid.Row="0" Orientation="Vertical" />

        <!-- Image path: streamed PNG frame, scrollable + centered. -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="#3C3C3C">
            <Grid Margin="16">
                <Image x:Name="FrameImage"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       SnapsToDevicePixels="True"
                       UseLayoutRounding="True" />
            </Grid>
        </ScrollViewer>

        <!-- Native path: the reparented live WinUI window is inserted here as Child. It FILLS the content row
             and clips to it. A native HWND ignores WPF ScrollViewer/visual clips (airspace), so it must be
             sized to the pane, not the design canvas — otherwise it paints over neighboring VS panes. The
             surface hosts a FIXED-size design canvas anchored top-left, so filling the pane yields a 1:1
             viewport onto that canvas, clipped to the pane (no reflow, no overlap). -->
        <Border x:Name="NativeHostHolder"
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="#3C3C3C"
                ClipToBounds="True"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True"
                Visibility="Collapsed" />

        <!-- Terminal recovery scrim (T11/T12): dims whatever stale frame remains behind the "Preview
             disconnected" status card so it reads as disconnected. -->
        <Border x:Name="ReconnectScrim"
                Grid.Row="1"
                Background="#A6000000"
                Visibility="Collapsed" />

        <!-- U2: the single BLOCKING status card — shown only when there is nothing (useful) to preview:
             loading, failed to start, XAML error with no prior render, not a designable page, and the
             terminal "Preview disconnected" state (with its Reload action). Themed with VS tool-window
             brushes; severity is shown with the same status monikers as the info bars. -->
        <Border x:Name="StatusOverlay"
                Grid.Row="1"
                Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}"
                BorderThickness="1"
                Padding="24,18"
                Margin="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="4">
            <StackPanel Orientation="Vertical" MinWidth="220" MaxWidth="400">
                <imaging:CrispImage x:Name="StatusIcon"
                                    Width="32"
                                    Height="32"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,12"
                                    Visibility="Collapsed" />
                <ProgressBar x:Name="Spinner"
                             IsIndeterminate="True"
                             Height="3"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.SystemHighlightBrushKey}}"
                             Margin="0,0,0,12" />
                <TextBlock x:Name="StatusText"
                           Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Text="Starting preview…" />
                <TextBlock x:Name="StatusDetail"
                           Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.SystemGrayTextBrushKey}}"
                           FontSize="12"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Visibility="Collapsed" />
                <ContentControl x:Name="StatusActionHost"
                                HorizontalAlignment="Center"
                                Margin="0,14,0,0"
                                Focusable="False"
                                Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>